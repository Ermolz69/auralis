{
  "productName": "Auralis",
  "version": "../package.json",
  "identifier": "com.auralis.desktop",
  "build": {
    "beforeDevCommand": "task desktop:before-dev",
    "beforeBuildCommand": "task desktop:before-build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../apps/desktop/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/ffmpeg-*",
      "binaries/ffprobe-*",
      "binaries/yt-dlp-*",
      "binaries/FFMPEG-GPL-3.0.txt",
      "binaries/YT-DLP-UNLICENSE.txt",
      "binaries/THIRD-PARTY-NOTICES.txt",
      "binaries/media-tools-provenance.json"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Auralis",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: https://i.ytimg.com",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: https://i.ytimg.com",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:5173",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Ermolz69/auralis/releases/latest/download/latest.json"],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
