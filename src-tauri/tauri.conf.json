{
  "productName": "Auralis",
  "version": "0.1.0",
  "identifier": "com.auralis.app",
  "build": {
    "beforeDevCommand": "pnpm run frontend:dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../apps/desktop/dist"
  },
  "bundle": {
    "resources": ["binaries/*"]
  },
  "app": {
    "windows": [
      {
        "title": "Auralis",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: https://i.ytimg.com",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: https://i.ytimg.com",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:5173",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  }
}
