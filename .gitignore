# Global Ignore Rules

# Dependency directories
node_modules/
/.pnpm-store/
target/

# Build outputs
dist/
/.pages/
storybook-static/
coverage/
/release-assets/
/release-publish/

# Verified media tools are generated from tools/media-tools/manifest.json
/src-tauri/binaries/*

# Env files
.env
.env.*
!.env.example

# Updater signing keys must stay outside the repository
*.key
*.key.pub

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~
Auralis_UI_UX_Improvement_Roadmap.md
